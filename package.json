{
  "name": "blackwood-ember",
  "description": "A 369 KB pure-browser WebGL2 top-down survival horror engine inspired by Darkwood — custom 2D raycast visibility, deferred normal-mapped lighting, procedural audio & automated QA gates.",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "build:minitool": "node tools/build-minitool.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:sim": "tsx tools/checks/sim-check.ts",
    "check:smoke": "node tools/checks/smoke-check.mjs",
    "check:layout": "node tools/checks/layout-check.mjs",
    "check:layer": "node tools/checks/layer-check.mjs",
    "check:palette": "node tools/checks/palette-check.mjs",
    "check:perf": "node tools/checks/perf-check.mjs",
    "check:shotdiff": "node tools/checks/shotdiff.mjs",
    "check:minitool": "node tools/checks/minitool-smoke.mjs",
    "check:t1": "npm run lint && npm run check:sim && npm run check:smoke && npm run check:layout && npm run check:layer"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
